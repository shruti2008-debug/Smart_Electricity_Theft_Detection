# ==============================================================================
# Smart Electricity Theft Detection - Dashboard Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR FIREBASE WEB APP CONFIG VALUES.
# NEVER COMMIT .env.local OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=electricity-theft-detect-cae09.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=electricity-theft-detect-cae09
VITE_FIREBASE_STORAGE_BUCKET=electricity-theft-detect-cae09.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Firebase Realtime Database URL (Singapore region)
VITE_FIREBASE_DATABASE_URL=https://electricity-theft-detect-cae09-default-rtdb.asia-southeast1.firebasedatabase.app
